# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/linkup_dev

# JWT Secrets (used for authentication tokens)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production

# Frontend URL (CORS origin)
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# LLM Configuration — CV Parsing
# Set LLM_PROVIDER to "cloud" or "local" to choose the active backend.
# No code changes are needed when switching modes; only .env changes are required.
# ─────────────────────────────────────────────────────────────────────────────

# Which LLM backend to use: "cloud" | "local"  (default: local)
LLM_PROVIDER=local

# ── Cloud mode (LLM_PROVIDER=cloud) ──────────────────────────────────────────
# Works with any OpenAI-compatible API: OpenAI, Mistral, Anthropic (via proxy), etc.
# Changing provider only requires updating these three variables — no code changes.
#
# LLM_API_URL    — base URL of the chat/completions endpoint
#   OpenAI:   https://api.openai.com/v1
#   Mistral:  https://api.mistral.ai/v1
#   Anthropic compatible proxy: https://api.anthropic.com/v1 (if using proxy)
LLM_API_URL=https://api.openai.com/v1
#
# LLM_MODEL — model name passed in the request body
#   OpenAI:   gpt-4o-mini
#   Mistral:  mistral-small-latest
LLM_MODEL=gpt-4o-mini
#
# LLM_API_KEY — secret API key for the provider (not used in local mode)
LLM_API_KEY=your-api-key-here

# ── Local mode (LLM_PROVIDER=local) ──────────────────────────────────────────
# Calls a locally running Ollama (or any OpenAI-compatible local server).
# No API key is required.
#
# LLM_LOCAL_URL   — base URL of the local LLM server  (default: http://localhost:11434)
LLM_LOCAL_URL=http://localhost:11434
#
# LLM_LOCAL_MODEL — model name to use with the local server  (default: llama3)
LLM_LOCAL_MODEL=llama3

# Redis connection URL used by BullMQ for job queues
REDIS_URL=redis://localhost:6379

# File Storage (Cloudflare R2 or any S3-compatible provider)
# STORAGE_ENDPOINT  — S3 API endpoint
#   R2:   https://<account_id>.r2.cloudflarestorage.com
#   MinIO: http://localhost:9000
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your-r2-access-key-id
STORAGE_SECRET_KEY=your-r2-secret-access-key
STORAGE_BUCKET=cv-files
# STORAGE_PUBLIC_URL (optional) — base URL used in returned file URLs.
# Set this when your public-facing domain differs from the API endpoint,
# e.g. an R2 custom domain or R2.dev bucket URL.
# Defaults to STORAGE_ENDPOINT if not set.
# STORAGE_PUBLIC_URL=https://pub-xxxx.r2.dev

# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/linkup_dev

# JWT Secrets (used for authentication tokens)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production

# Frontend URL (CORS origin)
FRONTEND_URL=http://localhost:3000

# LLM API Configuration (for CV screening AI)
LLM_API_KEY=your-llm-api-key-here

# Redis connection URL used by BullMQ for job queues
REDIS_URL=redis://localhost:6379

# File Storage (Cloudflare R2 or any S3-compatible provider)
# STORAGE_ENDPOINT  — S3 API endpoint
#   R2:   https://<account_id>.r2.cloudflarestorage.com
#   MinIO: http://localhost:9000
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your-r2-access-key-id
STORAGE_SECRET_KEY=your-r2-secret-access-key
STORAGE_BUCKET=cv-files
# STORAGE_PUBLIC_URL (optional) — base URL used in returned file URLs.
# Set this when your public-facing domain differs from the API endpoint,
# e.g. an R2 custom domain or R2.dev bucket URL.
# Defaults to STORAGE_ENDPOINT if not set.
# STORAGE_PUBLIC_URL=https://pub-xxxx.r2.dev

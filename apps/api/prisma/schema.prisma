// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  plan        Plan      @default(FREE)
  suspended       Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users        User[]
  jobOpenings  JobOpening[]
  inviteTokens InviteToken[]

  @@map("organisations")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            Role     @default(RECRUITER)
  isActive        Boolean  @default(true)
  departureStatus String?
  organisationId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  jobOpenings    JobOpening[] @relation("CreatedBy")
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  chatSessions   ChatSession[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([organisationId])
  @@map("users")
}

model JobOpening {
  id                  String   @id @default(cuid())
  title               String
  profileDescription  String
  status              JobStatus @default(OPEN)
  organisationId      String
  createdById         String
  inboundEmail        String?  @unique
  inboundEmailCode    String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation  Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy     User         @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  candidates    Candidate[]
  notifications Notification[]
  chatSessions  ChatSession[]
  emailIngestionLogs EmailIngestionLog[]

  @@index([organisationId])
  @@index([inboundEmail])
  @@index([inboundEmailCode])
  @@map("job_openings")
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  title        String
  message      String
  jobOpeningId String
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([jobOpeningId])
  @@map("notifications")
}

model Candidate {
  id                String   @id @default(cuid())
  firstName         String?
  lastName          String?
  email             String?
  rawFileUrl        String
  parsedJson        Json?
  score             Int?
  scoreExplanation  Json?
  summary           String?
  interviewQuestions Json?
  status            CandidateStatus @default(PENDING)
  jobOpeningId      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  jobOpening    JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  @@index([jobOpeningId])
  @@map("candidates")
}

model EmailIngestionLog {
  id             String                @id @default(cuid())
  jobOpeningId   String?
  senderEmail    String
  subject        String?
  recipientEmail String
  attachmentCount Int                   @default(0)
  processedCount Int                   @default(0)
  rejectedCount  Int                   @default(0)
  spamScore      Float?
  status         EmailIngestionStatus  @default(PROCESSED)
  errorMessage   String?
  createdAt      DateTime              @default(now())

  jobOpening     JobOpening?           @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)

  @@index([jobOpeningId])
  @@index([createdAt])
  @@map("email_ingestion_logs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model InviteToken {
  id             String    @id @default(cuid())
  token          String    @unique
  email          String
  organisationId String
  role           Role
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organisationId])
  @@map("invite_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RECRUITER
}

enum JobStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum CandidateStatus {
  PENDING
  NEW
  SHORTLISTED
  REJECTED
  OFFERED
  SCORED
  FAILED
}

enum EmailIngestionStatus {
  PROCESSED
  PARTIAL
  REJECTED
  JOB_NOT_FOUND
  SPAM
}

enum NotificationType {
  JOB_PARSING_COMPLETED
  JOB_PARSING_FAILED
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

model ChatSession {
  id           String        @id @default(cuid())
  jobOpeningId String
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  jobOpening   JobOpening    @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@unique([userId, jobOpeningId])
  @@index([jobOpeningId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String          @id @default(cuid())
  sessionId String
  role      ChatMessageRole
  content   String          @db.Text
  createdAt DateTime        @default(now())

  session   ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
